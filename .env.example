# cp .env.example .env

# Telegram Bot Token (from @BotFather, majburiy)
BOT_TOKEN=

# Admin Telegram user ID'lari (vergul bilan ajratilgan, masalan: 12345678,87654321)
ADMIN_IDS=

# Google Gemini API kaliti (AI Shirinlik Somelyesi uchun)
# https://aistudio.google.com saytidan olinadi
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# To'lov provayder tokenlari (@BotFather -> Payments orqali olinadi)
CLICK_TOKEN=
PAYME_TOKEN=

# Shirinlik do'koni lokatsiyasi (SORO - Samarqand, Vagzal / "Saodat" restorani)
STORE_LAT=39.684100
STORE_LON=66.927500

# Yetkazib berish sozlamalari (so'mda)
BASE_DELIVERY_PRICE=12000
PRICE_PER_KM=2500
FREE_DELIVERY_THRESHOLD=250000

# Do'kon ish vaqti (08:30 - 22:00)
WORK_START=08:30
WORK_END=22:00
