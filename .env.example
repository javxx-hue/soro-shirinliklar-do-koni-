# cp .env.example .env && chmod 600 .env
# Railway'da bu fayl ishlatilmaydi, o'sha nomdagi Variables qo'yiladi.

# Telegram bot tokeni (BotFather'dan olinadi, majburiy)
# Masalan: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=

# Bot egasining Telegram user ID'si (faqat raqamlar, majburiy)
# O'z ID'ingizni @userinfobot orqali bilib olishingiz mumkin
OWNER_ID=

# Avtomatik javob yuborish rejimi (standart: false)
# false = faqat loglarda PREVIEW ko'rsatiladi, Telegramga yuborilmaydi
# true = Telegram Business orqali xabarlarga avtomatik javob yuboriladi
AUTO_SEND=false

# Google Gemini API kaliti (majburiy)
# https://aistudio.google.com saytidan "Get API key" orqali bepul olinadi.
GEMINI_API_KEY=

# Gemini modeli (standart: gemini-3.8-flash)
# Tezkor javoblar uchun gemini-3.8-flash, eng aqlli javoblar uchun gemini-3.8-pro tavsiya etiladi.
GEMINI_MODEL=gemini-3.8-flash

# Gemini API so'rov kutish vaqti soniyalarda (standart: 60)
GEMINI_TIMEOUT_SECONDS=60

# Limitga tushganda sovish vaqti daqiqalarda (standart: 30)
LIMIT_COOLDOWN_MINUTES=30

# Egasi chatda o'zi yozganda botning jim turish vaqti daqiqalarda (standart: 15, 0 = o'chirilgan)
OWNER_TAKEOVER_MINUTES=15

# Har bir chat uchun saqlanadigan xabarlar tarixi soni (standart: 30)
HISTORY_LIMIT=30
